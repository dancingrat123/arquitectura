# Copia este archivo a `.env` y ajusta los secretos.
POSTGRES_USER=sirif
POSTGRES_PASSWORD=cambia_esta_clave
DATABASE_URL=postgresql://sirif:cambia_esta_clave@db:5432/sirif
RABBITMQ_USER=sirif
RABBITMQ_PASS=cambia_esta_clave
JWT_SECRET=cambia_este_secreto_jwt
GRAFANA_PASSWORD=admin

# Token interno obligatorio entre api-service y data-service.
INTERNAL_TOKEN=cambia_este_token_interno
MONITORING_INTERVAL=3600
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
MODEL_VERSION=rf-clima-region-v2

# Fase 3: hashes PBKDF2-SHA256 (no contraseñas en claro).
# Genéralo y codifícalo en base64 para que docker compose no interprete sus `$`:
#   python -c "import base64; from passlib.context import CryptContext; h=CryptContext(schemes=['pbkdf2_sha256']).hash('TU_CLAVE'); print('base64:' + base64.b64encode(h.encode()).decode())"
# data-service acepta tanto el hash literal (`$pbkdf2-...`) como `base64:...`.
ADMIN_PASSWORD_HASH=base64:JHBia2RmMi1zaGEyNTYkMjkwMDAkVzJ1dDFUckgySHN2aFJCaVRDa0Y0QSRKZm9rLngzbmRQdmVKSlp5U2c3VUxUSS84RmUzV1E1bk55WExXMkRRZ1A4
# Solo entorno de desarrollo (roles de ejemplo):
ANALISTA_PASSWORD_HASH=base64:JHBia2RmMi1zaGEyNTYkMjkwMDAkVzJ1dDFUckgySHN2aFJCaVRDa0Y0QSRKZm9rLngzbmRQdmVKSlp5U2c3VUxUSS84RmUzV1E1bk55WExXMkRRZ1A4
VISUALIZADOR_PASSWORD_HASH=base64:JHBia2RmMi1zaGEyNTYkMjkwMDAkVzJ1dDFUckgySHN2aFJCaVRDa0Y0QSRKZm9rLngzbmRQdmVKSlp5U2c3VUxUSS84RmUzV1E1bk55WExXMkRRZ1A4

# Pesos de priorización (se normalizan por su suma; el puntaje queda en [0,100]).
PESO_RIESGO=0.5
PESO_VIVIENDAS=0.2
PESO_INFRA=0.15
PESO_VEGETACION=0.15

# Fase 4: el asistente responde siempre con el fallback local determinista.
# El LLM externo es opcional y solo reformula en segundo plano.
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Ingesta batch de NDVI (opcional).
NDVI_FILE=/app/datos/ml/ndvi_ejemplo.json
# NDVI_URL=https://ejemplo.cl/ndvi.json
